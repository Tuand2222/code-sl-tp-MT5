//+------------------------------------------------------------------+
void ProcessCoreLogic()
{
double dayPnl, dayPct, weekPnl, weekPct, monthPnl, monthPct;
CalculateDayWeekMonthPnl(dayPnl, dayPct, weekPnl, weekPct, monthPnl, monthPct);

bool accountWideRiskAction = g_manualForceLock || (InpRiskControlScope == SCOPE_ACCOUNT);
if((g_riskBreached || g_manualForceLock) && HasTradesInScope(accountWideRiskAction))
{
string msg = g_manualForceLock ? "Đang bật khóa thủ công" : g_breachReason;
CloseAllTradesAndOrders(msg, accountWideRiskAction);
if(!g_riskCloseNoticeShown)
{
Alert("EA RISK GUARD: Đã gửi yêu cầu đóng lệnh trong phạm vi bảo vệ. Lý do: ", msg);
g_riskCloseNoticeShown = true;
}
}
else if(!g_riskBreached && !g_manualForceLock)
g_riskCloseNoticeShown = false;

if(g_inRecoveryMode && g_enHalfRiskRec && CountPositionsInScope(InpRiskControlScope == SCOPE_ACCOUNT) > g_maxRecOrders)
{
ulong newestTicket = 0;
datetime newestTime = 0;
for(int k = PositionsTotal() - 1; k >= 0; k--)
{
ulong tk = PositionGetTicket(k);
if(tk > 0 && (InpRiskControlScope == SCOPE_ACCOUNT || PositionGetString(POSITION_SYMBOL) == _Symbol))
{
datetime tOpen = (datetime)PositionGetInteger(POSITION_TIME);
if(tOpen >= newestTime)
{ newestTime = tOpen; newestTicket = tk; }
}
}
if(newestTicket > 0)
{
if(ClosePositionWithConfirmation(newestTicket))
Alert("CHẾ ĐỘ PHỤC HỒI: Chỉ cho phép mở tối đa ", g_maxRecOrders, " lệnh! Đã đóng lệnh nhồi thêm #", newestTicket);
}
}

datetime newsWinStart = 0, newsWinEnd = 0;
g_newsLockedState = CheckNewsScheduleAndLock(newsWinStart, newsWinEnd);
if(g_enNewsFilter && g_newsLockedState)
{
for(int j = OrdersTotal() - 1; j >= 0; j--)
{
ulong ord = OrderGetTicket(j);
if(ord > 0 && (InpNewsFilterScope == SCOPE_ACCOUNT || OrderGetString(ORDER_SYMBOL) == _Symbol))
DeleteOrderWithConfirmation(ord);
}
for(int i = PositionsTotal() - 1; i >= 0; i--)
{
ulong t = PositionGetTicket(i);
if(t > 0 && (InpNewsFilterScope == SCOPE_ACCOUNT || PositionGetString(POSITION_SYMBOL) == _Symbol))
{
datetime posOpenTime = (datetime)PositionGetInteger(POSITION_TIME);
if(newsWinStart > 0 && posOpenTime >= newsWinStart && posOpenTime <= newsWinEnd)
{
if(ClosePositionWithConfirmation(t))
Alert("CẤM TRADE TRONG GIỜ TIN! Đã đóng lệnh mở trong khung cấm tin #", t);
}
}
}
}

double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
int buyCount = 0, sellCount = 0;
double buyVolSum = 0.0, sellVolSum = 0.0;
double buyPriceVolSum = 0.0, sellPriceVolSum = 0.0;
datetime earliestOpenTime = 0;
long anchorPosId = 0;
double repSL = 0.0, repTP = 0.0, netFloatingPnl = 0.0;

for(int i = PositionsTotal() - 1; i >= 0; i--)
{
ulong ticket = PositionGetTicket(i);
if(ticket == 0 || PositionGetString(POSITION_SYMBOL) != _Symbol)
continue;

double actualEntry = PositionGetDouble(POSITION_PRICE_OPEN);
double vol = PositionGetDouble(POSITION_VOLUME);
double sl = PositionGetDouble(POSITION_SL);
double tp = PositionGetDouble(POSITION_TP);
datetime oTime = (datetime)PositionGetInteger(POSITION_TIME);
long pId = PositionGetInteger(POSITION_IDENTIFIER);
double entry = GetFrozenClosedEntryPrice(pId, oTime, actualEntry);
bool isBuyPos = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);

netFloatingPnl += PositionGetDouble(POSITION_PROFIT) + PositionGetDouble(POSITION_SWAP);
if(earliestOpenTime == 0 || oTime < earliestOpenTime)
{
earliestOpenTime = oTime;
anchorPosId = pId;
}
if(sl > 0.0) repSL = sl;
if(tp > 0.0) repTP = tp;

if(isBuyPos)
{ buyCount++; buyVolSum += vol; buyPriceVolSum += entry * vol; }
else
{ sellCount++; sellVolSum += vol; sellPriceVolSum += entry * vol; }
}

int openCount = buyCount + sellCount;
g_mixedPositionFallback = (buyVolSum > 1e-8 && sellVolSum > 1e-8);
if(g_multiMode == MULTI_BASKET_VWAP && g_mixedPositionFallback)
{
if(!g_mixedModeWarningShown)
Alert("ĐANG CÓ CẢ BUY VÀ SELL: EA tạm chuyển sang quản lý từng lệnh để tránh gộp sai VWAP.");
g_mixedModeWarningShown = true;
}
else
g_mixedModeWarningShown = false;
ENUM_MULTI_ORDER_MODE activeMultiMode = (g_multiMode == MULTI_BASKET_VWAP && g_mixedPositionFallback) ? MULTI_INDIVIDUAL : g_multiMode;
bool basketIsLong = (buyVolSum >= sellVolSum);
double totalOpenVol = basketIsLong ? buyVolSum : sellVolSum;
double vwapEntry = (totalOpenVol > 0.0) ? ((basketIsLong ? buyPriceVolSum : sellPriceVolSum) / totalOpenVol) : 0.0;
double currentR = 0.0;


DrawOrderPinsAndTradingJournal(openCount, vwapEntry, basketIsLong);

if(openCount > 0 && totalOpenVol > 0.0)
{
ENUM_TRADE_SIDE activeSide = basketIsLong ? SIDE_LONG : SIDE_SHORT;
double curActualSlDist = (repSL > 0.0) ? MathAbs(vwapEntry - repSL) : 0.0;

g_resolvedAtrTf = ResolveActiveAtrTimeframe(openCount, anchorPosId, earliestOpenTime, curActualSlDist);
SyncAnchorDateFields(g_resolvedAtrTf, earliestOpenTime);

double rawTrail = ExecuteExactPineScriptFormula(g_resolvedAtrTf, earliestOpenTime, vwapEntry, activeSide, g_showAtrPlot && activeMultiMode == MULTI_BASKET_VWAP, false,
g_pineEntryLevel, g_pineFirstBarSlDist, g_pineStopPlotting, g_pineStartCalc);

string gvBestTrail = "EAP82_BSK_BESTTRAIL_" + IntegerToString(anchorPosId);
if(rawTrail > 0.0 && !g_pineStopPlotting)
{
if(GlobalVariableCheck(gvBestTrail))
{
double prevBest = GlobalVariableGet(gvBestTrail);
if(prevBest > 0.0)
rawTrail = basketIsLong ? MathMax(rawTrail, prevBest) : MathMin(rawTrail, prevBest);
}
GlobalVariableSet(gvBestTrail, rawTrail);
}
g_pineTrailingStop = rawTrail;

if(!g_showAtrPlot)
ObjectsDeleteAll(0, VIS_PREFIX + "ATRLINE_");

double slDistCalc, slPtsCalc, recLot, dispVol, dispRiskCash, dispRiskPct, dispRewardCash, partLot, remLot;
CalculateSizingAndActiveRules(openCount, totalOpenVol, vwapEntry, repSL, repTP, basketIsLong, anchorPosId, earliestOpenTime,
slDistCalc, slPtsCalc, recLot, dispVol, dispRiskCash, dispRiskPct, dispRewardCash, partLot, remLot);

double prevBarClose = iClose(_Symbol, g_resolvedAtrTf, 1);
datetime prevBarTime = iTime(_Symbol, g_resolvedAtrTf, 1);

if(activeMultiMode == MULTI_BASKET_VWAP)
{
string gvBasket1R = "EAP82_BSK_1R_" + IntegerToString(anchorPosId);
string gvBasketArmed = "EAP82_BSK_ARMED_" + IntegerToString(anchorPosId);
string gvBasketArmBar = "EAP82_BSK_ARMBAR_" + IntegerToString(anchorPosId);
string gvBasketCnt = "EAP82_BSK_CNT_" + IntegerToString(anchorPosId);
string gvBasketTier2 = "EAP82_BSK_TIER2_" + IntegerToString(anchorPosId);
string gvBasketT2Time = "EAP82_BSK_T2TIME_" + IntegerToString(anchorPosId);
string gvLockedInitSL = "EAP82_BSK_INITSL_" + IntegerToString(anchorPosId);
string gvLockedInitTP = "EAP82_BSK_INITTP_" + IntegerToString(anchorPosId);

int savedCnt = GlobalVariableCheck(gvBasketCnt) ? (int)GlobalVariableGet(gvBasketCnt) : 0;
double basket1R = GlobalVariableCheck(gvBasket1R) ? GlobalVariableGet(gvBasket1R) : 0.0;

bool isNewOrderAdded = (openCount > savedCnt);
bool slStillInRiskZone = (repSL > 0.0) && ((basketIsLong && repSL < vwapEntry - _Point) || (!basketIsLong && repSL > vwapEntry + _Point));

if(basket1R <= 0.0 || isNewOrderAdded || (slStillInRiskZone && !g_isTrailingArmedNow))
{
basket1R = slStillInRiskZone ? MathAbs(vwapEntry - repSL)
: ((slDistCalc > 0.0) ? slDistCalc : ((g_pineFirstBarSlDist > 0.0) ? g_pineFirstBarSlDist : (g_pineLatestAtr * g_customValueForFirstDay)));
double lockSL = (repSL > 0.0) ? repSL : (basketIsLong ? NormalizeDouble(vwapEntry - basket1R, _Digits) : NormalizeDouble(vwapEntry + basket1R, _Digits));
double lockTP = (repTP > 0.0) ? repTP : (basketIsLong ? NormalizeDouble(vwapEntry + basket1R * g_targetRR, _Digits) : NormalizeDouble(vwapEntry - basket1R * g_targetRR, _Digits));

GlobalVariableSet(gvBasket1R, basket1R);
GlobalVariableSet(gvLockedInitSL, lockSL);
GlobalVariableSet(gvLockedInitTP, lockTP);
GlobalVariableSet(gvBasketCnt, (double)openCount);
}
else if(openCount < savedCnt)
{
GlobalVariableSet(gvBasketCnt, (double)openCount);
}

double unifiedInitSL = GlobalVariableCheck(gvLockedInitSL) ? GlobalVariableGet(gvLockedInitSL)
: (basketIsLong ? NormalizeDouble(vwapEntry - basket1R, _Digits) : NormalizeDouble(vwapEntry + basket1R, _Digits));
double unifiedInitTP = GlobalVariableCheck(gvLockedInitTP) ? GlobalVariableGet(gvLockedInitTP)
: (basketIsLong ? NormalizeDouble(vwapEntry + basket1R * g_targetRR, _Digits) : NormalizeDouble(vwapEntry - basket1R * g_targetRR, _Digits));



bool useTrailWithoutHardTpAtPartial = (g_enPartial && g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && g_targetRR <= g_partialRR + 1e-5);
double brokerInitTP = useTrailWithoutHardTpAtPartial ? 0.0 : unifiedInitTP;

double buffer20Pct1R = basket1R * (g_tierPctOf1R / 100.0);
double activeWickBuffer = (g_sweepMode == SWEEP_HARD_SL_ON_LINE) ? 0.0 : buffer20Pct1R;

double livePrice = basketIsLong ? bid : ask;
double profitDist = basketIsLong ? (livePrice - vwapEntry) : (vwapEntry - livePrice);
currentR = (basket1R > 0.0) ? (profitDist / basket1R) : 0.0;
datetime curTfBar0 = iTime(_Symbol, g_resolvedAtrTf, 0);


for(int i = PositionsTotal() - 1; i >= 0; i--)
{
ulong ticket = PositionGetTicket(i);
if(ticket == 0 || PositionGetString(POSITION_SYMBOL) != _Symbol)
continue;
bool isLong = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
if(isLong != basketIsLong)
continue;

long posId = PositionGetInteger(POSITION_IDENTIFIER);
double curSL = PositionGetDouble(POSITION_SL);
double curTP = PositionGetDouble(POSITION_TP);
double curVol = PositionGetDouble(POSITION_VOLUME);
string gvPart = "EAP82_PART_" + IntegerToString(posId);
string gvInitDone = "EAP82_INITDONE_" + IntegerToString(posId);

if(g_autoSlTp && (!GlobalVariableCheck(gvInitDone) || isNewOrderAdded))
{
double targetInitSL = (curSL <= 0.0 || isNewOrderAdded) ? unifiedInitSL : curSL;
double targetInitTP = useTrailWithoutHardTpAtPartial ? 0.0 : ((curTP <= 0.0 || isNewOrderAdded) ? brokerInitTP : curTP);
bool levelsReady = (MathAbs(curSL - targetInitSL) < _Point && MathAbs(curTP - targetInitTP) < _Point);
if(!levelsReady && ModifyPositionWithConfirmation(ticket, targetInitSL, targetInitTP))
{
curSL = targetInitSL;
curTP = targetInitTP;
repSL = curSL;
repTP = curTP;
levelsReady = true;
}
if(levelsReady)
GlobalVariableSet(gvInitDone, 1.0);
else
Print("EA PRO: Could not attach initial SL/TP; will retry for position #", ticket);
}
if(useTrailWithoutHardTpAtPartial && curTP > 0.0)
{

if(ModifyPositionWithConfirmation(ticket, curSL, 0.0))
{ curTP = 0.0; repTP = 0.0; }
}

string gvPartRetry = "EAP82_PARTTRY_" + IntegerToString(posId);
string gvPartTarget = "EAP82_PARTTARGET_" + IntegerToString(posId);
string gvPartClosed = "EAP82_PARTCLOSED_" + IntegerToString(posId);
if(g_enPartial && !GlobalVariableCheck(gvPart) && currentR >= g_partialRR)
{
datetime now = TimeCurrent();
datetime lastTry = GlobalVariableCheck(gvPartRetry) ? (datetime)GlobalVariableGet(gvPartRetry) : 0;
if(lastTry == 0 || now - lastTry >= 3)
{
GlobalVariableSet(gvPartRetry, (double)now);
double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
if(lotStep <= 0.0) lotStep = 0.01;
double targetClose = GlobalVariableCheck(gvPartTarget) ? GlobalVariableGet(gvPartTarget) : FloorLotStep(curVol * (g_partialPct / 100.0));
if(!GlobalVariableCheck(gvPartTarget) && targetClose >= minLot && (curVol - targetClose) >= minLot - 1e-6)
GlobalVariableSet(gvPartTarget, targetClose);
double closedSoFar = GlobalVariableCheck(gvPartClosed) ? GlobalVariableGet(gvPartClosed) : 0.0;
double remainingToClose = targetClose - closedSoFar;
if(targetClose >= minLot && remainingToClose >= minLot && remainingToClose <= curVol - minLot + 1e-6)
{
double actualClosed = 0.0;
if(ClosePositionPartiallyByTicket(ticket, remainingToClose, actualClosed))
{
closedSoFar += actualClosed;
GlobalVariableSet(gvPartClosed, closedSoFar);
if(closedSoFar + lotStep * 0.5 >= targetClose)
{
GlobalVariableSet(gvPart, 1.0);
GlobalVariableDel(gvPartRetry);
GlobalVariableDel("EAP82_PARTWARN_" + IntegerToString(posId));
}
else
ReportPartialTPIssue(posId, StringFormat("Đã chốt %.2f/%.2f lot TP1; EA sẽ thử tiếp phần còn thiếu.", closedSoFar, targetClose));
}
else
ReportPartialTPIssue(posId, "Yêu cầu chốt một phần chưa được xác nhận; EA sẽ thử lại sau 3 giây.");
}
else
ReportPartialTPIssue(posId, StringFormat("Không thể chốt đủ %.2f lot TP1 từ khối lượng hiện tại %.2f theo min lot/bước lot; TP1 chưa được đánh dấu hoàn tất.", targetClose, curVol));
}
}

// Remove any remaining TP at the 2R trigger after attempting the partial close.
if(g_enPartial && currentR >= g_partialRR && curTP > 0.0)
{
if(ModifyPositionWithConfirmation(ticket, curSL, 0.0))
{ curTP = 0.0; repTP = 0.0; }
}
}


bool wasArmed = GlobalVariableCheck(gvBasketArmed) ? (GlobalVariableGet(gvBasketArmed) > 0.5) : false;
datetime armedBarTime = GlobalVariableCheck(gvBasketArmBar) ? (datetime)GlobalVariableGet(gvBasketArmBar) : 0;
bool justArmedNow = false;

if(currentR >= g_trailStartRR)
{
if(!wasArmed)
{
wasArmed = true;
justArmedNow = true;
armedBarTime = curTfBar0;
GlobalVariableSet(gvBasketArmed, 1.0);
GlobalVariableSet(gvBasketArmBar, (double)armedBarTime);
}
}
g_isTrailingArmedNow = wasArmed;


bool allowTrailStepNow = (g_isTrailingArmedNow && !justArmedNow && (armedBarTime == 0 || curTfBar0 > armedBarTime));

if(g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && allowTrailStepNow && g_pineTrailingStop > 0.0)
{
double tier3HardPrice = basketIsLong ? (g_pineTrailingStop - activeWickBuffer)
: (g_pineTrailingStop + activeWickBuffer);
if(g_enLock && currentR >= g_lockTrigRR)
{
double lockDist = basket1R * g_lockLvlRR;
double minLockProfitPrc = basketIsLong ? (vwapEntry + lockDist) : (vwapEntry - lockDist);
tier3HardPrice = basketIsLong ? MathMax(minLockProfitPrc, tier3HardPrice)
: MathMin(minLockProfitPrc, tier3HardPrice);
}

bool piercedTier3Realtime = (basketIsLong && livePrice <= tier3HardPrice) ||
(!basketIsLong && livePrice >= tier3HardPrice);

if(piercedTier3Realtime)
{
bool allSymbolPositionsClosed = CloseAllPositionsOnChartSymbol();
if(allSymbolPositionsClosed)
AlertThrottled("T3_SL_DONE", StringFormat("T3 (SL LUÔN): Giá xuyên thủng 3 tầng -> đã đóng toàn bộ vị thế trên %s.", _Symbol));
else
AlertThrottled("T3_SL_RETRY", StringFormat("T3 (SL LUÔN): Một số vị thế trên %s chưa đóng được; EA sẽ tiếp tục giám sát.", _Symbol));
return;
}

if(prevBarTime > earliestOpenTime && (armedBarTime == 0 || prevBarTime > armedBarTime))
{
bool closedBeyondTier1 = (basketIsLong && prevBarClose < g_pineTrailingStop) ||
(!basketIsLong && prevBarClose > g_pineTrailingStop);
bool closedBeyondTier3 = (basketIsLong && prevBarClose <= tier3HardPrice) ||
(!basketIsLong && prevBarClose >= tier3HardPrice);

if(g_sweepMode == SWEEP_3LAYER_20PCT_1R)
{
bool alreadyCutTier2 = GlobalVariableCheck(gvBasketTier2);
datetime lastT2Bar = GlobalVariableCheck(gvBasketT2Time) ? (datetime)GlobalVariableGet(gvBasketT2Time) : 0;

if(closedBeyondTier3)
{
bool allSymbolPositionsClosed = CloseAllPositionsOnChartSymbol();
if(allSymbolPositionsClosed)
AlertThrottled("T3_CLOSE_DONE", "T3: Nến đóng cửa xuyên thủng biên 20% của 1R -> đã đóng hết vị thế.");
else
AlertThrottled("T3_CLOSE_RETRY", "T3: Một số vị thế chưa đóng được; EA sẽ tiếp tục giám sát.");
return;
}
else if(closedBeyondTier1)
{
if(!alreadyCutTier2)
{
bool allTier2Done = true;
bool foundTier2Position = false;
for(int c = PositionsTotal() - 1; c >= 0; c--)
{
ulong tk = PositionGetTicket(c);
if(tk == 0 || PositionGetString(POSITION_SYMBOL) != _Symbol)
continue;
foundTier2Position = true;
long tier2PosId = PositionGetInteger(POSITION_IDENTIFIER);
string gvPosDone = "EAP82_BSK_T2POS_" + IntegerToString(tier2PosId);
if(GlobalVariableCheck(gvPosDone))
continue;
string gvTry = "EAP82_BSK_T2TRY_" + IntegerToString(tier2PosId);
datetime now = TimeCurrent();
datetime lastTry = GlobalVariableCheck(gvTry) ? (datetime)GlobalVariableGet(gvTry) : 0;
if(lastTry > 0 && now - lastTry < 3)
{ allTier2Done = false; continue; }
GlobalVariableSet(gvTry, (double)now);
double vol = PositionGetDouble(POSITION_VOLUME);
double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
if(lotStep <= 0.0) lotStep = 0.01;
string gvTarget = "EAP82_BSK_T2TARGET_" + IntegerToString(tier2PosId);
string gvClosed = "EAP82_BSK_T2CLOSED_" + IntegerToString(tier2PosId);
double targetClose = GlobalVariableCheck(gvTarget) ? GlobalVariableGet(gvTarget) : FloorLotStep(vol * 0.5);
if(!GlobalVariableCheck(gvTarget) && targetClose >= minLot && vol - targetClose >= minLot - 1e-6)
GlobalVariableSet(gvTarget, targetClose);
double closedSoFar = GlobalVariableCheck(gvClosed) ? GlobalVariableGet(gvClosed) : 0.0;
double remaining = targetClose - closedSoFar;
if(targetClose < minLot || remaining < minLot || remaining > vol - minLot + 1e-6)
{
allTier2Done = false;
ReportPartialTPIssue(tier2PosId, StringFormat("T2 không thể chia 50%% khối lượng %.2f theo min lot/bước lot của sàn.", vol));
continue;
}
double actualClosed = 0.0;
if(!ClosePositionPartiallyByTicket(tk, remaining, actualClosed))
{
allTier2Done = false;
ReportPartialTPIssue(tier2PosId, "T2 chưa được máy chủ xác nhận; EA sẽ thử lại.");
continue;
}
closedSoFar += actualClosed;
GlobalVariableSet(gvClosed, closedSoFar);
if(closedSoFar + lotStep * 0.5 >= targetClose)
{
GlobalVariableSet(gvPosDone, 1.0);
GlobalVariableDel(gvTry);
GlobalVariableDel("EAP82_PARTWARN_" + IntegerToString(tier2PosId));
}
else
{
allTier2Done = false;
ReportPartialTPIssue(tier2PosId, StringFormat("T2 đã cắt %.2f/%.2f lot; EA sẽ thử tiếp phần còn thiếu.", closedSoFar, targetClose));
}
}
if(allTier2Done && foundTier2Position)
{
GlobalVariableSet(gvBasketTier2, prevBarClose);
GlobalVariableSet(gvBasketT2Time, (double)prevBarTime);
Alert(StringFormat("T2: Nến %s đóng cửa, không rút râu nhưng chưa vi phạm %.0f%% 1R -> đã cắt đủ 50%% vị thế.", GetTfShortName(g_resolvedAtrTf), g_tierPctOf1R));
}
}

// Once T2 has completed, monitor later ATR closes independently of the one-time partial-cut branch.
if(GlobalVariableCheck(gvBasketTier2) && prevBarTime > lastT2Bar)
{
double t2RefClose = GlobalVariableGet(gvBasketTier2);
bool droppedFurther = (basketIsLong && prevBarClose < t2RefClose) || (!basketIsLong && prevBarClose > t2RefClose);
if(droppedFurther)
{
bool allSymbolPositionsClosed = CloseAllPositionsOnChartSymbol();
if(allSymbolPositionsClosed)
AlertThrottled("T3_AFTER_T2_DONE", "T3: Giá tiếp tục giảm sau T2 -> đã đóng hết vị thế còn lại.");
else
AlertThrottled("T3_AFTER_T2_RETRY", "T3: Một số vị thế còn lại chưa đóng được; EA sẽ tiếp tục giám sát.");
return;
}
}
}
}
else if(g_sweepMode == SWEEP_WAIT_CANDLE_CLOSE && closedBeyondTier1)
{
bool allSymbolPositionsClosed = CloseAllPositionsOnChartSymbol();
if(allSymbolPositionsClosed)
AlertThrottled("ATR_WICK_DONE", "ATR WICK-PROOF: Nến đóng cửa vượt đường ATR -> đã đóng hết vị thế.");
else
AlertThrottled("ATR_WICK_RETRY", "ATR WICK-PROOF: Một số vị thế chưa đóng được; EA sẽ tiếp tục giám sát.");
return;
}
}
}

for(int i = PositionsTotal() - 1; i >= 0; i--)
{
ulong ticket = PositionGetTicket(i);
if(ticket == 0 || PositionGetString(POSITION_SYMBOL) != _Symbol)
continue;
bool isLong = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
if(isLong != basketIsLong)
continue;

if(g_trailStyle == TRAIL_STYLE_MANUAL_SL || justArmedNow)
continue;

double curSL = PositionGetDouble(POSITION_SL);
double curTP = PositionGetDouble(POSITION_TP);
double targetSL = curSL;

if(isLong)
{
if(g_enBe && currentR >= g_beRR)
{
double bePrice = NormalizeDouble(vwapEntry + g_bePoints * _Point, _Digits);
if(bePrice > targetSL) targetSL = bePrice;
}
if(g_enLock && currentR >= g_lockTrigRR)
{
double lockPrice = NormalizeDouble(vwapEntry + basket1R * g_lockLvlRR, _Digits);
if(lockPrice > targetSL) targetSL = lockPrice;
}
if(g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && allowTrailStepNow && g_pineTrailingStop > 0.0)
{
double brokerTier3SL = NormalizeDouble(g_pineTrailingStop - activeWickBuffer, _Digits);
if(brokerTier3SL > targetSL)
targetSL = brokerTier3SL;
}
if(targetSL > curSL + _Point * 0.5 && targetSL < bid)
{
if(ModifyPositionWithConfirmation(ticket, targetSL, curTP))
repSL = targetSL;
}
}
else
{
if(g_enBe && currentR >= g_beRR)
{
double bePrice = NormalizeDouble(vwapEntry - g_bePoints * _Point, _Digits);
if(targetSL <= 0.0 || bePrice < targetSL) targetSL = bePrice;
}
if(g_enLock && currentR >= g_lockTrigRR)
{
double lockPrice = NormalizeDouble(vwapEntry - basket1R * g_lockLvlRR, _Digits);
if(targetSL <= 0.0 || lockPrice < targetSL) targetSL = lockPrice;
}
if(g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && allowTrailStepNow && g_pineTrailingStop > 0.0)
{
double brokerTier3SL = NormalizeDouble(g_pineTrailingStop + activeWickBuffer, _Digits);
if(targetSL <= 0.0 || brokerTier3SL < targetSL)
targetSL = brokerTier3SL;
}
if(targetSL > 0.0 && (curSL <= 0.0 || targetSL < curSL - _Point * 0.5) && targetSL > ask)
{
if(ModifyPositionWithConfirmation(ticket, targetSL, curTP))
repSL = targetSL;
}
}
}

DrawCurrentAtrSpotlight(g_pineTrailingStop, basket1R, activeSide, openCount, repSL, g_pineStopPlotting, currentR, g_isTrailingArmedNow);
}
else // MULTI_INDIVIDUAL
{
g_isTrailingArmedNow = false;
ObjectsDeleteAll(0, VIS_PREFIX + "ATRLINE_");
DrawCurrentAtrSpotlight(0.0, 0.0, basketIsLong ? SIDE_LONG : SIDE_SHORT, openCount, repSL, false, currentR, false);
for(int i = PositionsTotal() - 1; i >= 0; i--)
{
ulong ticket = PositionGetTicket(i);
if(ticket == 0 || PositionGetString(POSITION_SYMBOL) != _Symbol)
continue;

long posId = PositionGetInteger(POSITION_IDENTIFIER);
datetime openTime = (datetime)PositionGetInteger(POSITION_TIME);
double actualEntry = PositionGetDouble(POSITION_PRICE_OPEN);
double curSL = PositionGetDouble(POSITION_SL);
double curTP = PositionGetDouble(POSITION_TP);
double curVol = PositionGetDouble(POSITION_VOLUME);
bool isLong = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY);
double livePrice = isLong ? bid : ask;

ENUM_TIMEFRAMES indTf = ResolveActiveAtrTimeframe(1, posId, openTime, (curSL > 0.0 ? MathAbs(actualEntry - curSL) : 0.0));
double entry = GetFrozenClosedEntryPrice(posId, openTime, actualEntry);
double indEntry = 0.0, indFirstDist = 0.0;
bool indStopPlot = false, indStart = false;
double indTrail = ExecuteExactPineScriptFormula(indTf, openTime, entry, isLong ? SIDE_LONG : SIDE_SHORT, false, false,
indEntry, indFirstDist, indStopPlot, indStart);

string gvBestInd = "EAP82_IND_BEST_" + IntegerToString(posId);
if(indTrail > 0.0 && !indStopPlot)
{
if(GlobalVariableCheck(gvBestInd))
{
double prevB = GlobalVariableGet(gvBestInd);
if(prevB > 0.0)
indTrail = isLong ? MathMax(indTrail, prevB) : MathMin(indTrail, prevB);
}
GlobalVariableSet(gvBestInd, indTrail);
}

string gv1R = "EAP82_1R_" + IntegerToString(posId);
string gvPart = "EAP82_PART_" + IntegerToString(posId);
string gvArmed = "EAP82_ARMED_" + IntegerToString(posId);
string gvArmBar = "EAP82_ARMBAR_" + IntegerToString(posId);
string gvInitDone = "EAP82_INITDONE_" + IntegerToString(posId);
string gvTier2 = "EAP82_TIER2_" + IntegerToString(posId);
string gvT2Time = "EAP82_T2TIME_" + IntegerToString(posId);
double slDist = GlobalVariableCheck(gv1R) ? GlobalVariableGet(gv1R) : 0.0;

bool indSlInRisk = (curSL > 0.0) && ((isLong && curSL < entry - _Point) || (!isLong && curSL > entry + _Point));
if(slDist <= 0.0 || indSlInRisk)
{
slDist = indSlInRisk ? MathAbs(entry - curSL) : ((indFirstDist > 0.0) ? indFirstDist : slDistCalc);
GlobalVariableSet(gv1R, slDist);
}

bool useIndTrailNoHardTp = (g_enPartial && g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && g_targetRR <= g_partialRR + 1e-5);
if(g_autoSlTp && !GlobalVariableCheck(gvInitDone))
{
double initSL = (curSL > 0.0) ? curSL : (isLong ? NormalizeDouble(entry - slDist, _Digits) : NormalizeDouble(entry + slDist, _Digits));
double rawTP = (curTP > 0.0) ? curTP : (isLong ? NormalizeDouble(entry + slDist * g_targetRR, _Digits) : NormalizeDouble(entry - slDist * g_targetRR, _Digits));
double initTP = useIndTrailNoHardTp ? 0.0 : rawTP;
bool levelsReady = (MathAbs(curSL - initSL) < _Point && MathAbs(curTP - initTP) < _Point);
if(!levelsReady && ModifyPositionWithConfirmation(ticket, initSL, initTP))
{
curSL = initSL;
curTP = initTP;
levelsReady = true;
}
if(levelsReady)
GlobalVariableSet(gvInitDone, 1.0);
else
Print("EA PRO: Could not attach initial SL/TP; will retry for position #", ticket);
}
if(useIndTrailNoHardTp && curTP > 0.0)
{
if(ModifyPositionWithConfirmation(ticket, curSL, 0.0))
curTP = 0.0;
}

double indBuf20Pct1R = slDist * (g_tierPctOf1R / 100.0);
double indWickBuffer = (g_sweepMode == SWEEP_HARD_SL_ON_LINE) ? 0.0 : indBuf20Pct1R;

double profDist = isLong ? (livePrice - entry) : (entry - livePrice);
double ticketR = (slDist > 0.0) ? (profDist / slDist) : 0.0;
currentR = ticketR;
datetime indCurBar0 = iTime(_Symbol, indTf, 0);


string gvPartRetry = "EAP82_PARTTRY_" + IntegerToString(posId);
string gvPartTarget = "EAP82_PARTTARGET_" + IntegerToString(posId);
string gvPartClosed = "EAP82_PARTCLOSED_" + IntegerToString(posId);
if(g_enPartial && !GlobalVariableCheck(gvPart) && ticketR >= g_partialRR)
{
datetime now = TimeCurrent();
datetime lastTry = GlobalVariableCheck(gvPartRetry) ? (datetime)GlobalVariableGet(gvPartRetry) : 0;
if(lastTry == 0 || now - lastTry >= 3)
{
GlobalVariableSet(gvPartRetry, (double)now);
double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
if(lotStep <= 0.0) lotStep = 0.01;
double targetClose = GlobalVariableCheck(gvPartTarget) ? GlobalVariableGet(gvPartTarget) : FloorLotStep(curVol * (g_partialPct / 100.0));
if(!GlobalVariableCheck(gvPartTarget) && targetClose >= minLot && (curVol - targetClose) >= minLot - 1e-6)
GlobalVariableSet(gvPartTarget, targetClose);
double closedSoFar = GlobalVariableCheck(gvPartClosed) ? GlobalVariableGet(gvPartClosed) : 0.0;
double remainingToClose = targetClose - closedSoFar;
if(targetClose >= minLot && remainingToClose >= minLot && remainingToClose <= curVol - minLot + 1e-6)
{
double actualClosed = 0.0;
if(ClosePositionPartiallyByTicket(ticket, remainingToClose, actualClosed))
{
closedSoFar += actualClosed;
GlobalVariableSet(gvPartClosed, closedSoFar);
if(closedSoFar + lotStep * 0.5 >= targetClose)
{
GlobalVariableSet(gvPart, 1.0);
GlobalVariableDel(gvPartRetry);
GlobalVariableDel("EAP82_PARTWARN_" + IntegerToString(posId));
}
else
ReportPartialTPIssue(posId, StringFormat("Đã chốt %.2f/%.2f lot TP1; EA sẽ thử tiếp phần còn thiếu.", closedSoFar, targetClose));
}
else
ReportPartialTPIssue(posId, "Yêu cầu chốt một phần chưa được xác nhận; EA sẽ thử lại sau 3 giây.");
}
else
ReportPartialTPIssue(posId, StringFormat("Không thể chốt đủ %.2f lot TP1 từ khối lượng hiện tại %.2f theo min lot/bước lot; TP1 chưa được đánh dấu hoàn tất.", targetClose, curVol));
}
}
if(g_enPartial && ticketR >= g_partialRR && curTP > 0.0)
{
if(ModifyPositionWithConfirmation(ticket, curSL, 0.0))
curTP = 0.0;
}


bool ticketArmed = GlobalVariableCheck(gvArmed) ? (GlobalVariableGet(gvArmed) > 0.5) : false;
datetime indArmedBar = GlobalVariableCheck(gvArmBar) ? (datetime)GlobalVariableGet(gvArmBar) : 0;
bool indJustArmed = false;

if(ticketR >= g_trailStartRR && !ticketArmed)
{
ticketArmed = true;
indJustArmed = true;
indArmedBar = indCurBar0;
GlobalVariableSet(gvArmed, 1.0);
GlobalVariableSet(gvArmBar, (double)indArmedBar);
}
if(ticketArmed)
g_isTrailingArmedNow = true;

if(g_trailStyle == TRAIL_STYLE_MANUAL_SL || indJustArmed)
continue;

bool indAllowTrailNow = (ticketArmed && !indJustArmed && (indArmedBar == 0 || indCurBar0 > indArmedBar));
double indPrevClose = iClose(_Symbol, indTf, 1);
datetime indPrevTime = iTime(_Symbol, indTf, 1);

if(g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && indAllowTrailNow && indTrail > 0.0)
{
double t3HardP = isLong ? (indTrail - indWickBuffer) : (indTrail + indWickBuffer);
if(g_enLock && ticketR >= g_lockTrigRR)
{
double lockD = slDist * g_lockLvlRR;
double minFloorL = isLong ? (entry + lockD) : (entry - lockD);
t3HardP = isLong ? MathMax(minFloorL, t3HardP) : MathMin(minFloorL, t3HardP);
}

if((isLong && livePrice <= t3HardP) || (!isLong && livePrice >= t3HardP))
{
ClosePositionWithConfirmation(ticket);
continue;
}

if(indPrevTime > openTime && (indArmedBar == 0 || indPrevTime > indArmedBar))
{
bool cBeyondT1 = (isLong && indPrevClose < indTrail) || (!isLong && indPrevClose > indTrail);
bool cBeyondT3 = (isLong && indPrevClose <= t3HardP) || (!isLong && indPrevClose >= t3HardP);

if(g_sweepMode == SWEEP_3LAYER_20PCT_1R)
{
bool hasT2 = GlobalVariableCheck(gvTier2);
datetime t2T = GlobalVariableCheck(gvT2Time) ? (datetime)GlobalVariableGet(gvT2Time) : 0;

if(cBeyondT3)
{
ClosePositionWithConfirmation(ticket);
continue;
}
else if(cBeyondT1)
{
if(!hasT2)
{
string gvT2Try = "EAP82_T2TRY_" + IntegerToString(posId);
datetime now = TimeCurrent();
datetime lastTry = GlobalVariableCheck(gvT2Try) ? (datetime)GlobalVariableGet(gvT2Try) : 0;
if(lastTry == 0 || now - lastTry >= 3)
{
GlobalVariableSet(gvT2Try, (double)now);
double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
if(lotStep <= 0.0) lotStep = 0.01;
string gvT2Target = "EAP82_T2TARGET_" + IntegerToString(posId);
string gvT2Closed = "EAP82_T2CLOSED_" + IntegerToString(posId);
double targetClose = GlobalVariableCheck(gvT2Target) ? GlobalVariableGet(gvT2Target) : FloorLotStep(curVol * 0.5);
if(!GlobalVariableCheck(gvT2Target) && targetClose >= minLot && curVol - targetClose >= minLot - 1e-6)
GlobalVariableSet(gvT2Target, targetClose);
double closedSoFar = GlobalVariableCheck(gvT2Closed) ? GlobalVariableGet(gvT2Closed) : 0.0;
double remaining = targetClose - closedSoFar;
if(targetClose >= minLot && remaining >= minLot && remaining <= curVol - minLot + 1e-6)
{
double actualClosed = 0.0;
if(ClosePositionPartiallyByTicket(ticket, remaining, actualClosed))
{
closedSoFar += actualClosed;
GlobalVariableSet(gvT2Closed, closedSoFar);
if(closedSoFar + lotStep * 0.5 >= targetClose)
{
GlobalVariableSet(gvTier2, indPrevClose);
GlobalVariableSet(gvT2Time, (double)indPrevTime);
GlobalVariableDel(gvT2Try);
GlobalVariableDel("EAP82_PARTWARN_" + IntegerToString(posId));
}
else
ReportPartialTPIssue(posId, StringFormat("T2 đã cắt %.2f/%.2f lot; EA sẽ thử tiếp phần còn thiếu.", closedSoFar, targetClose));
}
else
ReportPartialTPIssue(posId, "T2 chưa được máy chủ xác nhận; EA sẽ thử lại.");
}
else
ReportPartialTPIssue(posId, StringFormat("T2 không thể chia 50%% khối lượng %.2f theo min lot/bước lot của sàn.", curVol));
}
}
else if(indPrevTime > t2T)
{
double prevT2Close = GlobalVariableGet(gvTier2);
if((isLong && indPrevClose < prevT2Close) || (!isLong && indPrevClose > prevT2Close))
{
ClosePositionWithConfirmation(ticket);
continue;
}
}
}
}
else if(g_sweepMode == SWEEP_WAIT_CANDLE_CLOSE && cBeyondT1)
{
ClosePositionWithConfirmation(ticket);
continue;
}
}
}

double targetSL = curSL;
if(isLong)
{
if(g_enBe && ticketR >= g_beRR)
{ double beP = NormalizeDouble(entry + g_bePoints * _Point, _Digits); if(beP > targetSL) targetSL = beP; }
if(g_enLock && ticketR >= g_lockTrigRR)
{ double flP = NormalizeDouble(entry + slDist * g_lockLvlRR, _Digits); if(flP > targetSL) targetSL = flP; }
if(g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && indAllowTrailNow && indTrail > 0.0)
{
double trP = NormalizeDouble(indTrail - indWickBuffer, _Digits);
if(trP > targetSL) targetSL = trP;
}
if(targetSL > curSL + _Point * 0.5 && targetSL < bid)
ModifyPositionWithConfirmation(ticket, targetSL, curTP);
}
else
{
if(g_enBe && ticketR >= g_beRR)
{ double beP = NormalizeDouble(entry - g_bePoints * _Point, _Digits); if(targetSL <= 0.0 || beP < targetSL) targetSL = beP; }
if(g_enLock && ticketR >= g_lockTrigRR)
{ double flP = NormalizeDouble(entry - slDist * g_lockLvlRR, _Digits); if(targetSL <= 0.0 || flP < targetSL) targetSL = flP; }
if(g_enTrail && g_trailStyle == TRAIL_STYLE_AUTO_ATR && indAllowTrailNow && indTrail > 0.0)
{
double trP = NormalizeDouble(indTrail + indWickBuffer, _Digits);
if(targetSL <= 0.0 || trP < targetSL) targetSL = trP;
}
if(targetSL > 0.0 && (curSL <= 0.0 || targetSL < curSL - _Point * 0.5) && targetSL > ask)
ModifyPositionWithConfirmation(ticket, targetSL, curTP);
}
}

}
}
else
{
g_isTrailingArmedNow = false;
g_resolvedAtrTf = ResolveActiveAtrTimeframe(0, 0, 0, 0.0);
SyncAnchorDateFields(g_resolvedAtrTf, 0);

datetime standbyAnchorTime = 0;
if(g_autoSyncDate)
{
datetime tfLookbackTime = iTime(_Symbol, g_resolvedAtrTf, g_standbyLookback);
standbyAnchorTime = (tfLookbackTime > 0) ? tfLookbackTime : (TimeCurrent() - PeriodSeconds(g_resolvedAtrTf) * g_standbyLookback);
}
else
{
standbyAnchorTime = StringToTime(StringFormat("%04d.%02d.%02d 00:00", g_entryDateYear, g_entryDateMonth, g_entryDateDay));
}

g_pineTrailingStop = ExecuteExactPineScriptFormula(g_resolvedAtrTf, standbyAnchorTime, g_entryPriceInput, g_tradeSide, g_showAtrPlot, g_autoRestartAtr,
g_pineEntryLevel, g_pineFirstBarSlDist, g_pineStopPlotting, g_pineStartCalc);
if(!g_showAtrPlot)
ObjectsDeleteAll(0, VIS_PREFIX + "ATRLINE_");

DrawCurrentAtrSpotlight(g_pineTrailingStop, g_pineFirstBarSlDist, g_tradeSide, 0, 0.0, g_pineStopPlotting, 0.0, false);
}

UpdateHudAndTabValues(dayPct, weekPct, monthPct, openCount, totalOpenVol, vwapEntry, repSL, repTP, basketIsLong, anchorPosId, earliestOpenTime, currentR, netFloatingPnl);
}

void ClampPanelCoordinates()
{
long chartW = ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
long chartH = ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);

int maxX = MathMax(5, (int)chartW - g_panelW - 6);
int maxY = MathMax(5, (int)chartH - g_headerH - 8);

if(g_panelX < 5) g_panelX = 5;
if(g_panelX > maxX) g_panelX = maxX;
if(g_panelY < 5) g_panelY = 5;
if(g_panelY > maxY) g_panelY = maxY;
}

