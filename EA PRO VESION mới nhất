int GetStepDigits(double step)
{
if(step <= 0.0)
return 2;
int digits = 0;
double temp = step;
while(MathAbs(MathRound(temp) - temp) > 1e-6 && digits < 8)
{
temp *= 10.0;
digits++;
}
return digits;
}

double FloorLotStep(double rawLot)
{
double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
double minL = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
double maxL = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
if(step <= 0.0)
step = 0.01;
double lots = MathFloor((rawLot + step * 1e-9) / step) * step;
if(lots < minL)
return 0.0;
if(lots > maxL)
lots = maxL;
return NormalizeDouble(lots, GetStepDigits(step));
}

// Use the last fully closed candle before the position's entry bar as the fixed entry reference.
double GetFrozenClosedEntryPrice(long positionId, datetime openTime, double actualEntry)
{
if(positionId <= 0)
return actualEntry;

string gvKey = "EAP82_CLOSEPX_" + IntegerToString(positionId);
if(GlobalVariableCheck(gvKey))
{
double savedPrice = GlobalVariableGet(gvKey);
if(savedPrice > 0.0)
return savedPrice;
}

ENUM_TIMEFRAMES refTf = _Period;
double closePrice = 0.0;
int entryShift = iBarShift(_Symbol, refTf, openTime, false);
if(entryShift >= 0)
closePrice = iClose(_Symbol, refTf, entryShift + 1);
if(closePrice <= 0.0 && entryShift == 0)
closePrice = iClose(_Symbol, refTf, 1);
if(closePrice <= 0.0)
closePrice = actualEntry;

if(closePrice > 0.0)
GlobalVariableSet(gvKey, closePrice);
return closePrice;
}

bool TradeRequestSucceeded(bool requestSent)
{
if(!requestSent)
return false;
uint retcode = trade.ResultRetcode();
return (retcode == TRADE_RETCODE_DONE || retcode == TRADE_RETCODE_DONE_PARTIAL || retcode == TRADE_RETCODE_NO_CHANGES);
}

